generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model organizations {
  id                         String                     @id @default(uuid()) @db.VarChar(36)
  name                       String                     @db.VarChar(255)
  legal_name                 String?                    @db.VarChar(255)
  tax_identifier             String?                    @db.VarChar(64)
  base_currency              String                     @default("INR") @db.VarChar(3)
  fiscal_year_start_month    Int                        @default(4)
  timezone                   String                     @default("Asia/Kolkata") @db.VarChar(64)
  is_active                  Boolean                    @default(true)
  created_at                 DateTime                   @default(now())
  updated_at                 DateTime                   @default(now()) @updatedAt

  organization_memberships   organization_memberships[]
  chart_of_accounts          chart_of_accounts[]
  journals                   journals[]
  analytic_accounts          analytic_accounts[]
  product_categories         product_categories[]
  products                   products[]
  contacts                   contacts[]
  commercial_documents       commercial_documents[]
  journal_entries            journal_entries[]
  payments                   payments[]
  budgets                    budgets[]
  tax_rates                  tax_rates[]
}

model app_users {
  id                         String                     @id @default(uuid()) @db.VarChar(36)
  email                      String                     @unique @db.VarChar(255)
  login_id                   String                     @unique @db.VarChar(64)
  password_hash              String?                    @db.VarChar(255)
  display_name               String                     @db.VarChar(255)
  phone                      String?                    @db.VarChar(32)
  role                       String                     @default("Administrator") @db.VarChar(64)
  is_active                  Boolean                    @default(true)
  created_at                 DateTime                   @default(now())
  updated_at                 DateTime                   @default(now()) @updatedAt

  organization_memberships   organization_memberships[]
}

model organization_memberships {
  id              String        @id @default(uuid()) @db.VarChar(36)
  organization_id String        @db.VarChar(36)
  user_id         String        @db.VarChar(36)
  role            String        @default("accountant") @db.VarChar(64)
  is_active       Boolean       @default(true)
  created_at      DateTime      @default(now())
  updated_at      DateTime      @default(now()) @updatedAt

  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  app_users       app_users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, user_id])
  @@index([organization_id])
  @@index([user_id])
}

model product_categories {
  id              String        @id @default(uuid()) @db.VarChar(36)
  organization_id String        @db.VarChar(36)
  parent_id       String?       @db.VarChar(36)
  name            String        @db.VarChar(255)
  code            String?       @db.VarChar(64)
  description     String?       @db.Text
  created_at      DateTime      @default(now())
  updated_at      DateTime      @default(now()) @updatedAt

  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  products        products[]

  @@index([organization_id])
}

model products {
  id                         String                      @id @default(uuid()) @db.VarChar(36)
  organization_id            String                      @db.VarChar(36)
  category_id                String?                     @db.VarChar(36)
  sku                        String                      @db.VarChar(64)
  name                       String                      @db.VarChar(255)
  description                String?                     @db.Text
  product_type               String                      @default("goods") @db.VarChar(32)
  sales_price                Decimal                     @default(0.00) @db.Decimal(15, 2)
  cost_price                 Decimal                     @default(0.00) @db.Decimal(15, 2)
  image_url                  String?                     @db.Text
  income_account_id          String?                     @db.VarChar(36)
  expense_account_id         String?                     @db.VarChar(36)
  is_active                  Boolean                     @default(true)
  created_at                 DateTime                    @default(now())
  updated_at                 DateTime                    @default(now()) @updatedAt
  deleted_at                 DateTime?

  organizations              organizations               @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  product_categories         product_categories?         @relation(fields: [category_id], references: [id], onDelete: SetNull)
  commercial_document_lines  commercial_document_lines[]
  inventory_movements        inventory_movements[]

  @@index([organization_id])
  @@index([category_id])
}

model inventory_movements {
  id             String    @id @default(uuid()) @db.VarChar(36)
  product_id     String    @db.VarChar(36)
  movement_type  String    @db.VarChar(32)
  quantity_delta Decimal   @default(0.00) @db.Decimal(15, 2)
  reference_type String?   @db.VarChar(64)
  reference_id   String?   @db.VarChar(36)
  created_at     DateTime  @default(now())

  products       products  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
}

model contacts {
  id                   String                 @id @default(uuid()) @db.VarChar(36)
  organization_id      String                 @db.VarChar(36)
  contact_type         String                 @default("customer") @db.VarChar(32)
  display_name         String                 @db.VarChar(255)
  legal_name           String?                @db.VarChar(255)
  tax_identifier       String?                @db.VarChar(64)
  email                String?                @db.VarChar(255)
  phone                String?                @db.VarChar(32)
  image_url            String?                @db.Text
  website              String?                @db.VarChar(255)
  is_active            Boolean                @default(true)
  created_at           DateTime               @default(now())
  updated_at           DateTime               @default(now()) @updatedAt
  deleted_at           DateTime?

  organizations        organizations          @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  contact_addresses    contact_addresses[]
  commercial_documents commercial_documents[]
  payments             payments[]
  journal_entries      journal_entries[]

  @@index([organization_id])
}

model contact_addresses {
  id           String    @id @default(uuid()) @db.VarChar(36)
  contact_id   String    @db.VarChar(36)
  address_type String    @default("billing") @db.VarChar(32)
  line1        String    @db.VarChar(255)
  line2        String?   @db.VarChar(255)
  city         String?   @db.VarChar(128)
  state        String?   @db.VarChar(128)
  postal_code  String?   @db.VarChar(32)
  country_code String    @default("IN") @db.VarChar(2)
  is_default   Boolean   @default(true)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @default(now()) @updatedAt

  contacts     contacts  @relation(fields: [contact_id], references: [id], onDelete: Cascade)

  @@index([contact_id])
}

model chart_of_accounts {
  id                  String                @id @default(uuid()) @db.VarChar(36)
  organization_id     String                @db.VarChar(36)
  account_code        String                @db.VarChar(32)
  name                String                @db.VarChar(255)
  account_type        String                @db.VarChar(32)
  is_active           Boolean               @default(true)
  parent_account_id   String?               @db.VarChar(36)
  created_at          DateTime              @default(now())
  updated_at          DateTime              @default(now()) @updatedAt

  organizations       organizations         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  journal_entry_lines journal_entry_lines[]
  budget_lines        budget_lines[]

  @@unique([organization_id, account_code])
  @@index([organization_id])
}

model journals {
  id                         String            @id @default(uuid()) @db.VarChar(36)
  organization_id            String            @db.VarChar(36)
  name                       String            @db.VarChar(255)
  code                       String?           @db.VarChar(32)
  type                       String            @db.VarChar(32)
  default_account_id         String?           @db.VarChar(36)
  default_debit_account_id   String?           @db.VarChar(36)
  default_credit_account_id  String?           @db.VarChar(36)
  is_active                  Boolean           @default(true)
  created_at                 DateTime          @default(now())
  updated_at                 DateTime          @default(now()) @updatedAt

  organizations              organizations     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  journal_entries            journal_entries[]

  @@index([organization_id])
}

model analytic_accounts {
  id                        String                      @id @default(uuid()) @db.VarChar(36)
  organization_id           String                      @db.VarChar(36)
  code                      String?                     @db.VarChar(64)
  name                      String                      @db.VarChar(255)
  type                      String                      @default("expense") @db.VarChar(32)
  description               String?                     @db.Text
  is_active                 Boolean                     @default(true)
  created_at                DateTime                    @default(now())
  updated_at                DateTime                    @default(now()) @updatedAt

  organizations             organizations               @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  commercial_document_lines commercial_document_lines[]
  journal_entry_lines       journal_entry_lines[]
  budget_lines              budget_lines[]

  @@index([organization_id])
}

model commercial_documents {
  id                        String                      @id @default(uuid()) @db.VarChar(36)
  organization_id           String                      @db.VarChar(36)
  contact_id                String                      @db.VarChar(36)
  document_type             String                      @db.VarChar(32)
  document_number           String                      @db.VarChar(64)
  document_date             DateTime                    @default(now())
  due_date                  DateTime?
  currency_code             String                      @default("INR") @db.VarChar(3)
  status                    String                      @default("draft") @db.VarChar(32)
  subtotal_amount           Decimal                     @default(0.00) @db.Decimal(15, 2)
  tax_amount                Decimal                     @default(0.00) @db.Decimal(15, 2)
  total_amount              Decimal                     @default(0.00) @db.Decimal(15, 2)
  origin_document_id        String?                     @db.VarChar(36)
  created_at                DateTime                    @default(now())
  updated_at                DateTime                    @default(now()) @updatedAt
  deleted_at                DateTime?

  organizations             organizations               @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  contacts                  contacts                    @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  origin_document           commercial_documents?       @relation("DocumentHierarchy", fields: [origin_document_id], references: [id], onDelete: SetNull)
  derived_documents         commercial_documents[]      @relation("DocumentHierarchy")
  commercial_document_lines commercial_document_lines[]
  payment_allocations       payment_allocations[]

  @@unique([organization_id, document_type, document_number])
  @@index([organization_id])
  @@index([contact_id])
  @@index([origin_document_id])
}

model commercial_document_lines {
  id                     String               @id @default(uuid()) @db.VarChar(36)
  commercial_document_id String               @db.VarChar(36)
  product_id             String?              @db.VarChar(36)
  description            String               @db.VarChar(255)
  quantity               Decimal              @default(1.00) @db.Decimal(15, 2)
  unit_price             Decimal              @default(0.00) @db.Decimal(15, 2)
  line_tax_amount        Decimal              @default(0.00) @db.Decimal(15, 2)
  line_total_amount      Decimal              @default(0.00) @db.Decimal(15, 2)
  analytic_account_id    String?              @db.VarChar(36)
  created_at             DateTime             @default(now())

  commercial_documents   commercial_documents @relation(fields: [commercial_document_id], references: [id], onDelete: Cascade)
  products               products?            @relation(fields: [product_id], references: [id], onDelete: SetNull)
  analytic_accounts      analytic_accounts?   @relation(fields: [analytic_account_id], references: [id], onDelete: SetNull)

  @@index([commercial_document_id])
  @@index([product_id])
  @@index([analytic_account_id])
}

model journal_entries {
  id                  String                @id @default(uuid()) @db.VarChar(36)
  organization_id     String                @db.VarChar(36)
  journal_id          String                @db.VarChar(36)
  entry_number        String                @db.VarChar(64)
  entry_date          DateTime              @default(now())
  partner_id          String?               @db.VarChar(36)
  reference           String?               @db.VarChar(255)
  status              String                @default("draft") @db.VarChar(32)
  total_amount        Decimal               @default(0.00) @db.Decimal(15, 2)
  created_at          DateTime              @default(now())
  updated_at          DateTime              @default(now()) @updatedAt

  organizations       organizations         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  journals            journals              @relation(fields: [journal_id], references: [id], onDelete: Cascade)
  contacts            contacts?             @relation(fields: [partner_id], references: [id], onDelete: SetNull)
  journal_entry_lines journal_entry_lines[]

  @@unique([organization_id, entry_number])
  @@index([organization_id])
  @@index([journal_id])
  @@index([partner_id])
}

model journal_entry_lines {
  id                  String             @id @default(uuid()) @db.VarChar(36)
  journal_entry_id    String             @db.VarChar(36)
  account_id          String             @db.VarChar(36)
  partner_id          String?            @db.VarChar(36)
  analytic_account_id String?            @db.VarChar(36)
  description         String?            @db.VarChar(255)
  debit_amount        Decimal            @default(0.00) @db.Decimal(15, 2)
  credit_amount       Decimal            @default(0.00) @db.Decimal(15, 2)
  created_at          DateTime           @default(now())

  journal_entries     journal_entries    @relation(fields: [journal_entry_id], references: [id], onDelete: Cascade)
  chart_of_accounts   chart_of_accounts  @relation(fields: [account_id], references: [id], onDelete: Cascade)
  analytic_accounts   analytic_accounts? @relation(fields: [analytic_account_id], references: [id], onDelete: SetNull)

  @@index([journal_entry_id])
  @@index([account_id])
  @@index([analytic_account_id])
}

model payments {
  id                  String                @id @default(uuid()) @db.VarChar(36)
  organization_id     String                @db.VarChar(36)
  contact_id          String                @db.VarChar(36)
  payment_number      String                @db.VarChar(64)
  payment_date        DateTime              @default(now())
  payment_direction   String                @default("inbound") @db.VarChar(16)
  payment_method      String                @default("bank_transfer") @db.VarChar(32)
  amount              Decimal               @default(0.00) @db.Decimal(15, 2)
  currency_code       String                @default("INR") @db.VarChar(3)
  created_at          DateTime              @default(now())

  organizations       organizations         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  contacts            contacts              @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  payment_allocations payment_allocations[]

  @@unique([organization_id, payment_number])
  @@index([organization_id])
  @@index([contact_id])
}

model payment_allocations {
  id                     String               @id @default(uuid()) @db.VarChar(36)
  payment_id             String               @db.VarChar(36)
  commercial_document_id String               @db.VarChar(36)
  allocated_amount       Decimal              @default(0.00) @db.Decimal(15, 2)
  created_at             DateTime             @default(now())

  payments               payments             @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  commercial_documents   commercial_documents @relation(fields: [commercial_document_id], references: [id], onDelete: Cascade)

  @@index([payment_id])
  @@index([commercial_document_id])
}

model budgets {
  id                 String         @id @default(uuid()) @db.VarChar(36)
  organization_id    String         @db.VarChar(36)
  name               String         @db.VarChar(255)
  period_start       DateTime
  period_end         DateTime
  currency_code      String         @default("INR") @db.VarChar(3)
  status             String         @default("draft") @db.VarChar(32)
  responsible        String?        @db.VarChar(255)
  revision_of_id     String?        @db.VarChar(36)
  revision_of_name   String?        @db.VarChar(255)
  revised_with_id    String?        @db.VarChar(36)
  revised_with_name  String?        @db.VarChar(255)
  created_at         DateTime       @default(now())
  updated_at         DateTime       @default(now()) @updatedAt

  organizations      organizations  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  budget_lines       budget_lines[]

  @@index([organization_id])
}

model budget_lines {
  id                  String             @id @default(uuid()) @db.VarChar(36)
  budget_id           String             @db.VarChar(36)
  analytic_account_id String?            @db.VarChar(36)
  account_id          String?            @db.VarChar(36)
  line_type           String             @default("expense") @db.VarChar(32)
  planned_amount      Decimal            @default(0.00) @db.Decimal(15, 2)
  committed_amount    Decimal            @default(0.00) @db.Decimal(15, 2)
  achieved_amount     Decimal            @default(0.00) @db.Decimal(15, 2)
  amount_to_achieve   Decimal            @default(0.00) @db.Decimal(15, 2)
  created_at          DateTime           @default(now())

  budgets             budgets            @relation(fields: [budget_id], references: [id], onDelete: Cascade)
  analytic_accounts   analytic_accounts? @relation(fields: [analytic_account_id], references: [id], onDelete: SetNull)
  chart_of_accounts   chart_of_accounts? @relation(fields: [account_id], references: [id], onDelete: SetNull)

  @@index([budget_id])
  @@index([analytic_account_id])
  @@index([account_id])
}

model tax_rates {
  id              String        @id @default(uuid()) @db.VarChar(36)
  organization_id String        @db.VarChar(36)
  name            String        @db.VarChar(128)
  rate_percentage Decimal       @default(0.00) @db.Decimal(5, 2)
  is_active       Boolean       @default(true)
  created_at      DateTime      @default(now())

  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
}

model currencies {
  code           String   @id @db.VarChar(3)
  name           String   @db.VarChar(64)
  symbol         String   @db.VarChar(8)
  decimal_places Int      @default(2)
  is_active      Boolean  @default(true)
}
